POSTGRES_PASSWORD=change-me

# Compose reads this file. The monitor and the tests don't, so export what you need in your shell.

# With this set, cargo test uses the compose Postgres instead of starting its own.
TEST_DATABASE_URL=postgres://anhanguera_monitor:change-me@127.0.0.1:5432/anhanguera_monitor?sslmode=disable

# The monitor's settings. Under monitor-hub, set them in the hub's .env with the ANHANGUERA__
# prefix (ANHANGUERA__COURSES and so on). The monitor gets each value without the prefix.
DATABASE_URL=postgres://anhanguera_monitor:change-me@127.0.0.1:5432/anhanguera_monitor?sslmode=disable
AVA_USERNAME=00000000000
AVA_PASSWORD=change-me
COURSES=Example Course
CHECK_INTERVAL=1h
PAYMENT_REMINDER_DAYS=7,3,1,0
PAYMENT_OVERDUE_REPEAT=24h
BOLETO_LINK=true
BILLING_DAY_NET=auto
DEADLINE_REMINDER_DAYS=7,3,1
CALENDAR_CATEGORIES=FINANCIAL,SECRETARIAT,UNIQUE_EVENTS
REMINDER_HOUR=9
FAILING_ALERT_AFTER=24h
AVA_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
